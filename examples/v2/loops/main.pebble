fn isPrime(n) {
  if (n < 2) { return false; }
  for divisor in range(2, floor(sqrt(n)) + 1) {
    if (n % divisor == 0) { return false; }
  }
  return true;
}

let primes = [];
for n in range(2, 100) {
  if (!isPrime(n)) { continue; }
  primes.push(n);
  if (primes.length == 15) { break; }
}
print("First 15 primes:");
print(primes);
print("In reverse:", primes.reverse());
